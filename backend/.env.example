# Backend runtime
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# PostgreSQL connection. Replace the placeholder locally; never commit real credentials.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/iron_peak_fitness?schema=public

# Secret placeholders only. Generate environment-specific values outside source control.
SESSION_SECRET=replace-with-a-development-secret-at-least-32-characters
SESSION_COOKIE_NAME=iron_peak_session
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_DAYS=30
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Browser client origin(s)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# AI fitness assistant powered by Groq.
# Leave AI_API_KEY empty to run the assistant in demo mode
# (catalog-driven canned answers, clearly labelled in the chat panel).
# Groq exposes an OpenAI-compatible API: the key is sent to {AI_BASE_URL}/chat/completions.
# Get a key at https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_MAX_TOKENS=1200
AI_TIMEOUT_MS=20000
