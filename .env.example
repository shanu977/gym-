# Frontend build configuration (Vite). Only variables prefixed with VITE_ are exposed to the browser.
# Never put API keys, database URLs or session secrets in VITE_ variables.

# Origin of the Iron Peak API. Leave empty to call the same origin that serves the frontend.
# Production builds ignore localhost/127.0.0.1 values and fall back to same-origin requests.
VITE_API_BASE_URL=http://localhost:4000

# Feature switches. Production builds force every switch below to "on"; these only affect local dev.
VITE_AUTH_API=true
VITE_CUSTOMER_PROFILE_API=true
VITE_CUSTOMER_ADDRESS_API=true
VITE_CUSTOMER_CART_API=true
VITE_CUSTOMER_WISHLIST_API=true
